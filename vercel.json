{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/what-we-do",
      "destination": "/#package",
      "permanent": true
    },
    {
      "source": "/our-work",
      "destination": "/brand-films",
      "permanent": true
    },
    {
      "source": "/g",
      "destination": "/s",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/s",
      "destination": "/api/share"
    },
    {
      "source": "/v",
      "destination": "/api/share"
    },
    {
      "source": "/blog",
      "destination": "https://creativelygrow-next.vercel.app/blog"
    },
    {
      "source": "/blog/:path*",
      "destination": "https://creativelygrow-next.vercel.app/blog/:path*"
    },
    {
      "source": "/_next/:path*",
      "destination": "https://creativelygrow-next.vercel.app/_next/:path*"
    }
  ]
}
